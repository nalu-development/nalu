<!--
  Nalu.Maui.LiveActivities — automatic iOS widget extension.

  For iOS APP builds on macOS this wires up the widget a Live Activity needs to render:

    1. copies the bundled generic widget (SwiftUI rendering the shared content model)
       into obj/ and builds it with xcodebuild for the right SDK slice, stamping
       PRODUCT_BUNDLE_IDENTIFIER=$(ApplicationId).$(NaluLiveActivitiesWidgetBundleSuffix);
    2. embeds the resulting .appex via AdditionalAppExtensions (the .NET iOS SDK copies
       it into PlugIns/ and codesigns it with the app's identity).

  The app itself must declare NSSupportsLiveActivities=true in Platforms/iOS/Info.plist —
  automatic injection via PartialAppManifest proved unreliable in real apps, so the key is
  a documented manual step (see conceptual_docs/liveactivities.md).

  Customization properties:
    - NaluLiveActivitiesWidget           false to disable everything (default: true for Exe projects)
    - NaluLiveActivitiesWidgetProject    path to a custom widget .xcodeproj (custom SwiftUI —
                                         start by copying the bundled one; keep the attributes
                                         struct name NaluLiveActivityAttributes)
    - NaluLiveActivitiesWidgetTarget     xcodebuild target name (default: NaluLiveActivitiesWidget)
    - NaluLiveActivitiesWidgetBundleSuffix  appex bundle id suffix (default: widget)
    - NaluLiveActivitiesWidgetDisplayName   user-visible widget name (default: $(ApplicationTitle))

  Device builds note: the appex is signed with the app's signing identity; store/device
  distribution requires the usual per-bundle-id provisioning on the Apple developer portal.
-->
<Project>

  <PropertyGroup>
    <NaluLiveActivitiesWidget Condition="'$(NaluLiveActivitiesWidget)' == '' and '$(OutputType)' == 'Exe'">true</NaluLiveActivitiesWidget>
    <NaluLiveActivitiesWidgetProject Condition="'$(NaluLiveActivitiesWidgetProject)' == ''">$(MSBuildThisFileDirectory)NaluLiveActivitiesWidget.xcodeproj</NaluLiveActivitiesWidgetProject>
    <NaluLiveActivitiesWidgetTarget Condition="'$(NaluLiveActivitiesWidgetTarget)' == ''">NaluLiveActivitiesWidget</NaluLiveActivitiesWidgetTarget>
    <NaluLiveActivitiesWidgetBundleSuffix Condition="'$(NaluLiveActivitiesWidgetBundleSuffix)' == ''">widget</NaluLiveActivitiesWidgetBundleSuffix>
    <NaluLiveActivitiesWidgetDisplayName Condition="'$(NaluLiveActivitiesWidgetDisplayName)' == ''">$(ApplicationTitle)</NaluLiveActivitiesWidgetDisplayName>
    <_NaluWidgetEnabled>false</_NaluWidgetEnabled>
    <_NaluWidgetEnabled Condition="'$(NaluLiveActivitiesWidget)' == 'true' and $([MSBuild]::IsOSPlatform('osx'))">true</_NaluWidgetEnabled>
  </PropertyGroup>

  <!-- Fail fast when the app manifest lacks NSSupportsLiveActivities: without the key
       ActivityKit rejects every activity at runtime with a cryptic error far from the fix.
       This is a READ-ONLY check on the COMPILED manifest — unlike manifest injection it has
       no ordering or incrementality hazards (at worst it fires one build later). The key
       name appears as literal bytes in both XML and binary plists. Runs regardless of the
       widget opt-out (a custom widget still needs the key); suppress with
       <NaluLiveActivitiesManifestCheck>false</NaluLiveActivitiesManifestCheck>. -->
  <Target Name="_NaluLiveActivitiesValidateManifest"
          Condition="'$(NaluLiveActivitiesManifestCheck)' != 'false' and '$(OutputType)' == 'Exe' and Exists('$(_TemporaryAppManifest)')"
          AfterTargets="_CompileAppManifest">
    <PropertyGroup>
      <_NaluManifestHasLiveActivitiesKey>$([System.IO.File]::ReadAllText('$(_TemporaryAppManifest)').Contains('NSSupportsLiveActivities'))</_NaluManifestHasLiveActivitiesKey>
    </PropertyGroup>

    <Error
        Code="NALU001"
        Condition="'$(_NaluManifestHasLiveActivitiesKey)' != 'True'"
        Text="Nalu.Maui.LiveActivities: NSSupportsLiveActivities is missing from the app's Info.plist, so ActivityKit will reject every Live Activity at runtime. Add &lt;key&gt;NSSupportsLiveActivities&lt;/key&gt;&lt;true/&gt; to Platforms/iOS/Info.plist. (Suppress this check with &lt;NaluLiveActivitiesManifestCheck&gt;false&lt;/NaluLiveActivitiesManifestCheck&gt;.)" />
  </Target>

  <!-- 1 + 2. Build the widget appex and hand it to the SDK for embedding + codesigning.
       Everything is computed at target-execution time: RuntimeIdentifier is still empty
       during evaluation, and a device appex embedded into a simulator app silently fails
       pluginkit registration. -->
  <Target Name="_NaluLiveActivitiesBuildWidget"
          Condition="'$(_NaluWidgetEnabled)' == 'true'"
          BeforeTargets="_ExtendAppExtensionReferences">
    <PropertyGroup>
      <_NaluWidgetSdk>iphoneos</_NaluWidgetSdk>
      <_NaluWidgetSdk Condition="$(RuntimeIdentifier.StartsWith('iossimulator'))">iphonesimulator</_NaluWidgetSdk>
      <_NaluWidgetRoot>$([System.IO.Path]::GetFullPath('$(IntermediateOutputPath)naluwidget/'))</_NaluWidgetRoot>
      <_NaluWidgetSrc>$([System.IO.Path]::GetDirectoryName('$(NaluLiveActivitiesWidgetProject)'))</_NaluWidgetSrc>
      <_NaluWidgetProjName>$([System.IO.Path]::GetFileName('$(NaluLiveActivitiesWidgetProject)'))</_NaluWidgetProjName>
    </PropertyGroup>

    <!-- Build outside the package cache: xcodebuild must never write next to the nupkg
         contents, and a local copy keeps custom projects' relative paths intact too. -->
    <ItemGroup>
      <_NaluWidgetSources Include="$(_NaluWidgetSrc)/**/*" Exclude="$(_NaluWidgetSrc)/**/xcuserdata/**" />
    </ItemGroup>

    <Copy SourceFiles="@(_NaluWidgetSources)"
          DestinationFiles="@(_NaluWidgetSources->'$(_NaluWidgetRoot)src/%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />

    <Exec Command="xcodebuild -project &quot;$(_NaluWidgetRoot)src/$(_NaluWidgetProjName)&quot; -target &quot;$(NaluLiveActivitiesWidgetTarget)&quot; -configuration Release -sdk $(_NaluWidgetSdk) CODE_SIGNING_ALLOWED=NO &quot;PRODUCT_BUNDLE_IDENTIFIER=$(ApplicationId).$(NaluLiveActivitiesWidgetBundleSuffix)&quot; &quot;INFOPLIST_KEY_CFBundleDisplayName=$(NaluLiveActivitiesWidgetDisplayName)&quot; &quot;CONFIGURATION_BUILD_DIR=$(_NaluWidgetRoot)$(_NaluWidgetSdk)&quot; &quot;SYMROOT=$(_NaluWidgetRoot)sym&quot; &quot;OBJROOT=$(_NaluWidgetRoot)obj&quot; build"
          StandardOutputImportance="low" />

    <ItemGroup>
      <AdditionalAppExtensions Include="$(_NaluWidgetRoot.TrimEnd('/'))">
        <Name>$(NaluLiveActivitiesWidgetTarget)</Name>
        <BuildOutput>$(_NaluWidgetSdk)</BuildOutput>
      </AdditionalAppExtensions>
      <FileWrites Include="$(_NaluWidgetRoot)**/*" />
    </ItemGroup>
  </Target>

</Project>
