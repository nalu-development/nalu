<?xml version="1.0" encoding="UTF-8" ?>
<nalu:Scaffold xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:nalu="https://nalu-development.github.com/nalu/scaffold"
               xmlns:pages="clr-namespace:MauiNaluApp.Pages"
               x:Class="MauiNaluApp.AppScaffold"
               nalu:Scaffold.PageTransition="{x:Static nalu:ScaffoldPageTransition.SlideFromRight}">

    <!-- The whole application structure: one tab bar, two roots, each hosting its own
         navigation stack. Pages are plain ContentPages resolved through Nalu navigation. -->

    <!-- The bar is a TEMPLATE: every page realizes its own instance, because the bar travels
         with its page and two are on screen during any transition. The app-wide surface colors
         live in Styles.xaml with the rest of the styling; a page overrides them one property at
         a time. -->
    <nalu:Scaffold.NavBarTemplate>
        <DataTemplate>
            <nalu:ScaffoldNavBarView />
        </DataTemplate>
    </nalu:Scaffold.NavBarTemplate>

    <nalu:ScaffoldTabBar>
        <nalu:ScaffoldRoot Title="Home" PageType="{x:Type pages:HomePage}">
            <nalu:ScaffoldRoot.Icon>
                <FontImageSource FontFamily="Material" Glyph="&#xe88a;" Color="{StaticResource TabIcon}" Size="24" />
            </nalu:ScaffoldRoot.Icon>
            <nalu:ScaffoldRoot.SelectedIcon>
                <FontImageSource FontFamily="Material" Glyph="&#xe88a;" Color="{StaticResource Accent}" Size="24" />
            </nalu:ScaffoldRoot.SelectedIcon>
        </nalu:ScaffoldRoot>

        <nalu:ScaffoldRoot Title="Settings" PageType="{x:Type pages:SettingsPage}">
            <nalu:ScaffoldRoot.Icon>
                <FontImageSource FontFamily="Material" Glyph="&#xe8b8;" Color="{StaticResource TabIcon}" Size="24" />
            </nalu:ScaffoldRoot.Icon>
            <nalu:ScaffoldRoot.SelectedIcon>
                <FontImageSource FontFamily="Material" Glyph="&#xe8b8;" Color="{StaticResource Accent}" Size="24" />
            </nalu:ScaffoldRoot.SelectedIcon>
        </nalu:ScaffoldRoot>
    </nalu:ScaffoldTabBar>

</nalu:Scaffold>
