<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- The Nalu Scaffold hosts the app on iOS and Android. -->
        <TargetFrameworks>net10.0-android</TargetFrameworks>
        <TargetFrameworks Condition="!$([MSBuild]::IsOSPlatform('linux'))">$(TargetFrameworks);net10.0-ios</TargetFrameworks>

        <OutputType>Exe</OutputType>
        <RootNamespace>MauiNaluApp</RootNamespace>
        <UseMaui>true</UseMaui>

        <!-- Pin a recent MAUI patch: without this the workload's bundled default applies
             (e.g. 10.0.20), which still carries Android chrome rendering bugs fixed in later
             patches (stale tab bar pills under the shadowed bar). -->
        <MauiVersion>10.0.90</MauiVersion>
        <SingleProject>true</SingleProject>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <!-- Compiled bindings for source-compiled XAML: faster and trim/AOT-safe. -->
        <MauiEnableXamlCBindingWithSourceCompilation>true</MauiEnableXamlCBindingWithSourceCompilation>

        <!-- Display name -->
        <ApplicationTitle>XmlEncodedAppName</ApplicationTitle>

        <!-- App Identifier -->
        <ApplicationId>com.companyname.naluscaffoldapp</ApplicationId>

        <!-- Versions -->
        <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
        <ApplicationVersion>1</ApplicationVersion>

        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
    </PropertyGroup>

    <ItemGroup>
        <!-- App Icon -->
        <MauiIcon Include="Resources/AppIcon/appicon.svg" ForegroundFile="Resources/AppIcon/appiconfg.svg" Color="#4C7DF0" />

        <!-- Splash Screen -->
        <MauiSplashScreen Include="Resources/Splash/splash.svg" Color="#4C7DF0" BaseSize="128,128" />

        <!-- Images -->
        <MauiImage Include="Resources/Images/*" />

        <!-- Custom Fonts -->
        <MauiFont Include="Resources/Fonts/*" />

        <!-- Raw Assets (also remove the "Resources/Raw" prefix) -->
        <MauiAsset Include="Resources/Raw/**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
        <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
        <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
        <PackageReference Include="Nalu.Maui.Navigation" Version="NALU_PACKAGE_VERSION" />
        <PackageReference Include="Nalu.Maui.Scaffold" Version="NALU_PACKAGE_VERSION" />
    </ItemGroup>

</Project>
