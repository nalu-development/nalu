<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Nalu.Maui.UITests</RootNamespace>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
  </PropertyGroup>

  <ItemGroup>
    <!-- UI tests drive one shared app instance: the runner must never overlap them.
         The config file is what Rider/VS read; BaseUiTest.cs carries the same settings as
         assembly attributes for plain `dotnet test`. -->
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Experimental preview: version pinned on purpose, bump deliberately.
         All usages of the Driver API must go through Infrastructure/NaluApp.cs
         so preview breaking changes only affect one file. -->
    <!-- The Driver already depends on SkiaSharp (used by NaluApp.GetPixelColorAsync). -->
    <PackageReference Include="Microsoft.Maui.DevFlow.Driver" Version="0.1.0-preview.12.26368.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Chaos HTTP server for the background-session fault-injection suite: hosted IN-PROCESS by
         ChaosServerFixture (the device reaches it over the LAN), shared with the standalone
         manual runner in Tools/Nalu.ChaosServer (dotnet run). -->
    <ProjectReference Include="..\..\Tools\Nalu.ChaosServer\Nalu.ChaosServer.csproj" />
  </ItemGroup>

</Project>
