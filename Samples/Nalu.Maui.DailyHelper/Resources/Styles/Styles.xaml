<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    xmlns:nalu="https://nalu-development.github.com/nalu/scaffold">

    <Style TargetType="ContentPage" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource BackgroundLight}, Dark={StaticResource BackgroundDark}}" />
    </Style>

    <Style TargetType="Label" ApplyToDerivedTypes="True">
        <Setter Property="FontFamily" Value="Regular" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
    </Style>

    <Style x:Key="Muted" TargetType="Label">
        <Setter Property="FontFamily" Value="Regular" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
    </Style>

    <Style x:Key="SectionTitle" TargetType="Label">
        <Setter Property="FontFamily" Value="SemiBold" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
    </Style>

    <Style x:Key="Icon" TargetType="Label">
        <Setter Property="FontFamily" Value="Material" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
    </Style>

    <Style TargetType="Button">
        <Setter Property="FontFamily" Value="SemiBold" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="BackgroundColor" Value="{StaticResource Accent}" />
        <Setter Property="TextColor" Value="{StaticResource AccentContrast}" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="16,12" />
    </Style>

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 20" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource CardLight}, Dark={StaticResource CardDark}}" />
    </Style>

    <Style x:Key="Divider" TargetType="BoxView">
        <Setter Property="HeightRequest" Value="1" />
        <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource DividerLight}, Dark={StaticResource DividerDark}}" />
    </Style>

    <Style TargetType="Entry">
        <Setter Property="FontFamily" Value="Regular" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
    </Style>

    <Style TargetType="Editor">
        <Setter Property="FontFamily" Value="Regular" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
    </Style>

    <Style TargetType="Switch">
        <Setter Property="OnColor" Value="{StaticResource Accent}" />
    </Style>

    <!-- Scaffold chrome. Every styling property of the default components carries a real
         default value, so plain implicit styles override it — no palette resolver, no theme
         subscriptions, just AppThemeBinding where it belongs. -->

    <Style TargetType="nalu:ScaffoldNavBarView">
        <Setter Property="BarBackground">
            <Setter.Value>
                <SolidColorBrush Color="{AppThemeBinding Light={StaticResource BackgroundLight}, Dark={StaticResource BackgroundDark}}" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="nalu:ScaffoldNavBarTitle">
        <Setter Property="FontFamily" Value="SemiBold" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
    </Style>

    <!-- Back, close and both drawer buttons at once. -->
    <Style TargetType="nalu:ScaffoldNavBarButtonBase" ApplyToDerivedTypes="True">
        <Setter Property="IconColor" Value="{StaticResource Accent}" />
    </Style>

    <!-- The bar itself: pill container only. -->
    <Style TargetType="nalu:ScaffoldTabBarView">
        <Setter Property="BarBackground">
            <Setter.Value>
                <SolidColorBrush Color="{AppThemeBinding Light={StaticResource CardLight}, Dark={StaticResource CardDark}}" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Item + badge appearance: applies to bar items AND overflow rows (same component). -->
    <Style TargetType="nalu:ScaffoldTabBarItemView">
        <Setter Property="FontFamily" Value="Regular" />
        <Setter Property="TextColor" Value="{StaticResource TabIcon}" />
        <Setter Property="SelectedTextColor" Value="{StaticResource Accent}" />
        <Setter Property="BadgeTextColor" Value="{StaticResource AccentContrast}" />
        <Setter Property="SelectionPillBackground">
            <Setter.Value>
                <SolidColorBrush Color="{AppThemeBinding Light={StaticResource AccentSoftLight}, Dark={StaticResource AccentSoftDark}}" />
            </Setter.Value>
        </Setter>
        <Setter Property="BadgeBackground">
            <Setter.Value>
                <SolidColorBrush Color="{StaticResource Accent}" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="nalu:ScaffoldTabBarOverflowView">
        <Setter Property="PanelBackground">
            <Setter.Value>
                <SolidColorBrush Color="{AppThemeBinding Light={StaticResource CardLight}, Dark={StaticResource CardDark}}" />
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
